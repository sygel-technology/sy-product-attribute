<odoo>
    <record id="gb_filosanitary_botanic_denomination" model="ir.ui.view">
        <field name="name">gb.filosanitary.botanic.denomination</field>
        <field name="model">botanic.denomination</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name" />
            </list>
        </field>
    </record>
    <record model="ir.actions.act_window" id="action_botanic_denomination">
        <field name="name">Botanic Denomination</field>
        <field name="view_id" ref="gb_filosanitary_botanic_denomination" />
        <field name="res_model">botanic.denomination</field>
        <field name="view_mode">list</field>
    </record>
    <menuitem
        id="menu_botanic_denomination"
        parent="stock.menu_product_in_config_stock"
        action="action_botanic_denomination"
    />
</odoo>
